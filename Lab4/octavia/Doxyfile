# Doxyfile corregido para proyecto C/C++ (Raspberry Pi Pico SDK)
# Ejecutar desde la carpeta raíz del proyecto: doxygen Doxyfile

PROJECT_NAME           = "Proyecto Raspberry Pi Pico"
PROJECT_BRIEF          = "Documentación del firmware"
OUTPUT_DIRECTORY       = .
CREATE_SUBDIRS         = NO

# Archivos de entrada: busca desde la raíz y entra a todas las subcarpetas.
INPUT                  = .
INPUT_ENCODING         = UTF-8
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.h *.cpp *.hpp *.cc *.hh *.ino *.md
EXCLUDE                = build html latex .git .vscode
EXCLUDE_PATTERNS       = */build/* */html/* */latex/* */.git/* */.vscode/*

# Mostrar funciones aunque no tengan comentarios Doxygen.
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# Documentación HTML.
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = AUTO_LIGHT
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = YES
HTML_DYNAMIC_MENUS     = YES
HTML_CODE_FOLDING      = YES

# Desactivar salidas que no se necesitan.
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

# Incluir código fuente en la documentación.
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
VERBATIM_HEADERS       = YES

# No detenerse por falta de comentarios; mostrar advertencias útiles.
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = NO
WARN_NO_PARAMDOC       = NO
WARN_LOGFILE           = doxygen_warnings.log

# C/C++: no se necesita compilar el proyecto para generar documentación.
OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES

# No tratar la carpeta de salida como entrada.
EXAMPLE_PATH           =
IMAGE_PATH             =
USE_MDFILE_AS_MAINPAGE =